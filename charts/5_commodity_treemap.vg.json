{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Commodity treemap: area encodes production value; each commodity uses its reserved page-wide colour.",
  "width": 640,
  "height": 464,
  "padding": 0,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "signals": [
    {
      "name": "width",
      "init": "containerSize()[0]",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0]"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "tree",
      "url": "data/5_commodity_value_2024_25.csv",
      "format": {
        "type": "csv",
        "parse": {
          "Value_AUD_million": "number",
          "Quantity_tonnes": "number",
          "Share_percent": "number"
        }
      },
      "transform": [
        {
          "type": "nest",
          "keys": [
            "Category"
          ],
          "generate": true
        },
        {
          "type": "treemap",
          "field": "Value_AUD_million",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "ratio": 1.4,
          "round": true,
          "paddingInner": 3,
          "paddingOuter": 3,
          "paddingTop": 24,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        },
        {
          "type": "formula",
          "expr": "datum.y0 - 24",
          "as": "y0"
        },
        {
          "type": "formula",
          "expr": "datum.y1 - 24",
          "as": "y1"
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 1"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth == 2"
        }
      ]
    },
    {
      "name": "labels",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.x1 - datum.x0 > 110 && datum.y1 - datum.y0 > 85"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#f3f3f0"
          },
          "stroke": {
            "value": "#cccccc"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "commodityColour",
            "field": "Commodity"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Commodity': datum.Commodity, 'Category': datum.Category, 'Production value': 'A$' + format(datum.Value_AUD_million, ',.1f') + ' million', 'Share of total': format(datum.Share_percent, '.1f') + '%'}"
          }
        },
        "hover": {
          "stroke": {
            "value": "#292929"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "groups"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 7"
          },
          "y": {
            "signal": "datum.y0 + 7"
          },
          "text": {
            "signal": "datum.key == 'Finfish, Sharks and Rays' ? 'FINFISH, SHARKS AND RAYS' : upper(datum.key)"
          },
          "baseline": {
            "value": "top"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#292929"
          },
          "limit": {
            "signal": "max(0, datum.x1 - datum.x0 - 14)"
          },
          "font": {
            "value": "Arial"
          },
          "opacity": {
            "signal": "datum.x1 - datum.x0 >= 85 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "labels"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 9"
          },
          "y": {
            "signal": "datum.y0 + 12"
          },
          "text": {
            "signal": "datum.Commodity == 'Other Finfish, Sharks and Rays' ? 'Other finfish|sharks and rays' : datum.Commodity"
          },
          "baseline": {
            "value": "top"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "white"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 18"
          },
          "font": {
            "value": "Arial"
          },
          "lineBreak": {
            "value": "|"
          },
          "lineHeight": {
            "value": 16
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "labels"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 9"
          },
          "y": {
            "signal": "datum.y0 + (datum.Commodity == 'Other Finfish, Sharks and Rays' ? 44 : 28)"
          },
          "text": {
            "signal": "format(datum.Share_percent, '.1f') + '%'"
          },
          "baseline": {
            "value": "top"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "white"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 18"
          },
          "font": {
            "value": "Arial"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "background": "transparent"
  },
  "scales": [
    {
      "name": "commodityColour",
      "type": "ordinal",
      "domain": [
        "Salmonids",
        "Rock Lobsters",
        "Other Finfish, Sharks and Rays",
        "Prawns",
        "Oysters",
        "Tunas",
        "Crabs",
        "Other Crustaceans",
        "Abalone",
        "Scallops",
        "Squids",
        "Other Molluscs",
        "Other products"
      ],
      "range": [
        "#a63d64",
        "#087fba",
        "#70451f",
        "#355b98",
        "#824b6a",
        "#8f1538",
        "#8b6a00",
        "#5e5f59",
        "#c76545",
        "#9e4274",
        "#555072",
        "#c02983",
        "#d17b9b"
      ]
    }
  ],
  "background": "transparent"
}
