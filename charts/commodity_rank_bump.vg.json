{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Six selected commodity trajectories; ranks are calculated against all thirteen commodities.",
  "width": "container",
  "height": 420,
  "padding": {"left": 5, "right": 5, "top": 0, "bottom": 5},
  "autosize": {"type": "fit-x", "contains": "padding"},
  "data": {
    "url": "data/commodity_rank_history.csv",
    "format": {
      "type": "csv",
      "parse": {"YearIndex": "number", "Rank": "number", "Value_AUD_million": "number"}
    }
  },
  "transform": [
    {
      "filter": {
        "field": "Commodity",
        "oneOf": ["Salmonids", "Rock Lobsters", "Prawns", "Tunas", "Abalone", "Oysters"]
      }
    },
    {"calculate": "replace(datum.Year, '-', '–')", "as": "FinancialYear"},
    {
      "calculate": "datum.Rank == 1 ? '1st' : datum.Rank == 2 ? '2nd' : datum.Rank == 3 ? '3rd' : datum.Rank + 'th'",
      "as": "RankLabel"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "sort": {"field": "YearIndex", "order": "ascending"},
      "title": "Financial year",
      "axis": {
        "values": ["1998-99", "2003-04", "2008-09", "2013-14", "2018-19", "2024-25"],
        "labelExpr": "replace(datum.label, '-', '–')",
        "labelAngle": 0,
        "labelOverlap": false,
        "grid": false,
        "domain": false,
        "tickSize": 0,
        "labelPadding": 12
      }
    },
    "y": {
      "field": "Rank",
      "type": "quantitative",
      "scale": {
        "domain": [9.5, 0.5],
        "nice": false
      },
      "title": "Rank by production value",
      "axis": {
        "values": [1, 2, 3, 4, 5, 6, 7, 8, 9],
        "labelExpr": "datum.value == 1 ? '1st' : datum.value == 2 ? '2nd' : datum.value == 3 ? '3rd' : datum.value + 'th'",
        "grid": true,
        "domain": false,
        "tickSize": 0,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.2},
      "encoding": {
        "detail": {"field": "Commodity"},
        "order": {"field": "YearIndex"},
        "color": {
          "condition": [
            {"test": "datum.Commodity == 'Salmonids'", "value": "#344454"},
            {"test": "datum.Commodity == 'Rock Lobsters'", "value": "#607b87"}
          ],
          "value": "#8198a1"
        },
        "opacity": {
          "condition": [
            {"test": "datum.Commodity == 'Salmonids'", "value": 1},
            {"test": "datum.Commodity == 'Rock Lobsters'", "value": 0.95}
          ],
          "value": 0.95
        },
        "strokeWidth": {
          "condition": [
            {"test": "datum.Commodity == 'Salmonids'", "value": 3},
            {"test": "datum.Commodity == 'Rock Lobsters'", "value": 1.8}
          ],
          "value": 1.8
        }
      }
    },
    {
      "transform": [
        {"filter": "datum.YearIndex == 0 || datum.YearIndex == 26"}
      ],
      "mark": {"type": "point", "filled": true, "size": 65, "opacity": 1},
      "encoding": {
        "color": {
          "condition": [
            {"test": "datum.Commodity == 'Salmonids'", "value": "#344454"},
            {"test": "datum.Commodity == 'Rock Lobsters'", "value": "#607b87"}
          ],
          "value": "#8198a1"
        },
        "tooltip": [
          {"field": "Commodity", "title": "Commodity"},
          {"field": "FinancialYear", "title": "Financial year"},
          {"field": "RankLabel", "title": "Rank"},
          {
            "field": "Value_AUD_million",
            "type": "quantitative",
            "title": "Production value (A$ million)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "mark": {"type": "circle", "opacity": 0, "size": 150},
      "encoding": {
        "tooltip": [
          {"field": "Commodity", "title": "Commodity"},
          {"field": "FinancialYear", "title": "Financial year"},
          {"field": "RankLabel", "title": "Rank"},
          {
            "field": "Value_AUD_million",
            "type": "quantitative",
            "title": "Production value (A$ million)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.YearIndex == 26"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 9, "fontWeight": 600},
      "encoding": {
        "text": {"field": "Commodity"},
        "color": {
          "condition": {"test": "datum.Commodity == 'Salmonids'", "value": "#344454"},
          "value": "#4c6570"
        }
      }
    },
    {
      "data": {
        "values": [
          {"Year": "2023-24", "Rank": 1.32, "Label": "Salmonids: seventh to first"}
        ]
      },
      "mark": {"type": "text", "align": "center", "baseline": "top", "dx": 30, "dy": 0, "fontWeight": 600, "color": "#344454"},
      "encoding": {
        "text": {"field": "Label"}
      }
    },
    {
      "data": {
        "values": [
          {"Year": "2023-24", "Rank": 1.32, "Label": "A$82 million to A$1.27 billion"}
        ]
      },
      "mark": {"type": "text", "align": "center", "baseline": "top", "dx": 30, "dy": 18, "fontWeight": 400, "color": "#344454"},
      "encoding": {
        "text": {"field": "Label"}
      }
    },
    {
      "data": {
        "values": [
          {"Year": "2003-04", "Rank": 1.42, "Label": "Rock lobsters slipped to third"}
        ]
      },
      "mark": {"type": "text", "align": "center", "baseline": "top", "dy": 0, "fontWeight": 600, "color": "#55696f"},
      "encoding": {
        "text": {"field": "Label"},
        "y": {"value": -23}
      }
    },
    {
      "data": {
        "values": [
          {"Year": "2003-04", "Rank": 1.42, "Label": "Value rose: A$431 to A$623 million"}
        ]
      },
      "mark": {"type": "text", "align": "center", "baseline": "top", "dy": 18, "fontWeight": 400, "color": "#55696f"},
      "encoding": {
        "text": {"field": "Label"},
        "y": {"value": -23}
      }
    }
  ],
  "config": {
    "font": "Segoe UI",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": 400,
      "labelColor": "#55696f",
      "titleColor": "#55696f",
      "gridColor": "#e8eded",
      "gridOpacity": 0.4,
      "titlePadding": 16
    },
    "text": {"fontSize": 13}
  }
}
