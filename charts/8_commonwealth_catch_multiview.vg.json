{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Coordinated fishery-year heatmap, catch history and species breakdown. Clicks select one fishery and calendar year; missing records are not filled with zero.",
  "spacing": 28,
  "vconcat": [
    {
      "name": "catch_heatmap",
      "data": {
        "url": "data/8_afma_fishery_year_catch.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Year": "number",
            "FisheryOrder": "number",
            "LandedCatch_tonnes": "number",
            "SpeciesCount": "number"
          }
        }
      },
      "width": 500,
      "height": 352,
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "scale": {
            "domain": [
              2002,
              2003,
              2004,
              2005,
              2006,
              2007,
              2008,
              2009,
              2010,
              2011,
              2012,
              2013,
              2014,
              2015,
              2016,
              2017,
              2018,
              2019,
              2020,
              2021,
              2022,
              2023
            ]
          },
          "axis": {
            "title": null,
            "values": [
              2002,
              2007,
              2012,
              2017,
              2023
            ],
            "labelAngle": 0,
            "labelPadding": 8,
            "tickSize": 0,
            "domain": false
          }
        },
        "y": {
          "field": "FisheryLabel",
          "type": "nominal",
          "sort": {
            "field": "FisheryOrder"
          },
          "axis": {
            "title": null,
            "labelLimit": 0,
            "labelPadding": 8,
            "tickSize": 0,
            "domain": false,
            "labelExpr": "datum.label",
            "labelLineHeight": 13
          }
        }
      },
      "layer": [
        {
          "transform": [
            {
              "aggregate": [],
              "groupby": [
                "FisheryCode",
                "FisheryLabel",
                "FisheryOrder"
              ]
            },
            {
              "calculate": "sequence(2002, 2024)",
              "as": "Years"
            },
            {
              "flatten": [
                "Years"
              ],
              "as": [
                "Year"
              ]
            }
          ],
          "mark": {
            "type": "rect",
            "color": "#c6c6c6",
            "stroke": "white",
            "strokeWidth": 0.7
          }
        },
        {
          "mark": {
            "type": "rect",
            "cursor": "pointer"
          },
          "encoding": {
            "color": {
              "field": "LandedCatch_tonnes",
              "type": "quantitative",
              "scale": {
                "type": "sqrt",
                "domain": [
                  0,
                  25000
                ],
                "range": [
                  "#eee5f5",
                  "#756487"
                ]
              },
              "legend": {
                "title": "Landed catch (tonnes)",
                "orient": "top",
                "direction": "horizontal",
                "gradientLength": 300,
                "values": [
                  0,
                  5000,
                  10000,
                  15000,
                  25000
                ],
                "format": ",.0f",
                "titleLimit": 300
              }
            },
            "stroke": {
              "value": "white"
            },
            "strokeWidth": {
              "value": 0.7
            },
            "tooltip": [
              {
                "field": "Fishery",
                "title": "Fishery"
              },
              {
                "field": "Year",
                "type": "ordinal",
                "title": "Calendar year"
              },
              {
                "field": "LandedCatch_tonnes",
                "type": "quantitative",
                "title": "Landed catch (tonnes)",
                "format": ",.0f"
              }
            ]
          },
          "params": [
            {
              "name": "Fishery_select",
              "select": {
                "type": "point",
                "fields": [
                  "FisheryCode"
                ],
                "on": "@catch_heatmap_cells_marks:click",
                "clear": false,
                "toggle": false
              },
              "value": [
                {
                  "FisheryCode": "SPF"
                }
              ]
            },
            {
              "name": "Year_select",
              "select": {
                "type": "point",
                "fields": [
                  "Year"
                ],
                "on": "@catch_heatmap_cells_marks:click",
                "clear": false,
                "toggle": false
              },
              "value": [
                {
                  "Year": 2023
                }
              ]
            }
          ],
          "name": "catch_heatmap_cells"
        },
        {
          "name": "catch_heatmap_selection",
          "transform": [
            {
              "filter": {
                "and": [
                  {
                    "param": "Fishery_select",
                    "empty": false
                  },
                  {
                    "param": "Year_select",
                    "empty": false
                  }
                ]
              }
            }
          ],
          "mark": {
            "type": "rect",
            "fill": null,
            "stroke": "#292929",
            "strokeWidth": 2.5,
            "interactive": false
          }
        }
      ]
    },
    {
      "hconcat": [
        {
          "data": {
            "url": "data/8_afma_species_catch_clean.csv",
            "format": {
              "type": "csv",
              "parse": {
                "Year": "number",
                "LandedCatch_tonnes": "number"
              }
            }
          },
          "width": 500,
          "height": 160,
          "title": "Top six species",
          "transform": [
            {
              "filter": {
                "param": "Fishery_select",
                "empty": false
              }
            },
            {
              "filter": {
                "param": "Year_select",
                "empty": false
              }
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "LandedCatch_tonnes",
                  "as": "Catch"
                }
              ],
              "groupby": [
                "Species"
              ]
            },
            {
              "window": [
                {
                  "op": "row_number",
                  "as": "SpeciesRank"
                }
              ],
              "sort": [
                {
                  "field": "Catch",
                  "order": "descending"
                },
                {
                  "field": "Species"
                }
              ]
            },
            {
              "filter": "datum.SpeciesRank <= 6"
            }
          ],
          "mark": {
            "type": "bar",
            "color": "#756487"
          },
          "encoding": {
            "x": {
              "field": "Catch",
              "type": "quantitative",
              "axis": {
                "title": "Landed catch (tonnes)",
                "tickCount": 3,
                "format": ",.0f"
              }
            },
            "y": {
              "field": "Species",
              "type": "nominal",
              "sort": "-x",
              "axis": {
                "title": null,
                "labelLimit": 200,
                "labelFontSize": 12,
                "ticks": false,
                "domain": false,
                "labelExpr": "datum.label",
                "labelLineHeight": 13
              }
            },
            "tooltip": [
              {
                "field": "Species",
                "title": "Species"
              },
              {
                "field": "Catch",
                "type": "quantitative",
                "title": "Landed catch (tonnes)",
                "format": ",.0f"
              }
            ]
          }
        }
      ],
      "spacing": 24
    }
  ],
  "config": {
    "font": "Arial",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#606060",
      "titleColor": "#606060",
      "gridColor": "#eeeeee",
      "domain": false,
      "tickSize": 0,
      "titlePadding": 12
    },
    "title": {
      "fontSize": 14,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#292929",
      "offset": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 400
    }
  },
  "align": "each",
  "background": "transparent"
}
