{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Production value trends for three fisheries sectors, with selective annotations and hover tooltips.",
  "data": {
    "url": "data/1_sector_trend.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(substring(datum.Year, 0, 4))",
      "as": "StartYear"
    },
    {
      "calculate": "toNumber(datum.Value) / 1000",
      "as": "Billions"
    },
    {
      "calculate": "datum.Sector == 'State wild catch fisheries' ? 'State wild catch' : datum.Sector == 'Commonwealth fisheries' ? 'Commonwealth wild catch' : 'Aquaculture'",
      "as": "SectorLabel"
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 14,
      "labelColor": "#606060",
      "domainColor": "#d5d5d5",
      "tickColor": "#d5d5d5",
      "gridColor": "#f2f2f2",
      "gridWidth": 1,
      "titleFontSize": 14
    },
    "text": {
      "align": "right",
      "fontSize": 13,
      "lineBreak": "|",
      "lineHeight": 17
    }
  },
  "resolve": {
    "legend": {
      "color": "independent"
    }
  },
  "width": "container",
  "height": 390,
  "padding": {
    "left": 8,
    "top": 0,
    "right": 12,
    "bottom": 8
  },
  "encoding": {
    "x": {
      "field": "StartYear",
      "type": "quantitative",
      "scale": {
        "domain": [
          1998,
          2024
        ],
        "nice": false,
        "zero": false
      },
      "axis": {
        "title": "Financial year",
        "values": [
          1999,
          2004,
          2009,
          2014,
          2019,
          2024
        ],
        "labelExpr": "toString(datum.value) + '–' + substring(toString(datum.value + 1), 2)",
        "labelAngle": 0,
        "labelPadding": 12,
        "grid": false,
        "titleFontSize": 14,
        "titleFontWeight": 400,
        "titleColor": "#606060",
        "titlePadding": 16,
        "labelFontSize": 14,
        "labelOverlap": false,
        "labelFlush": false
      }
    },
    "y": {
      "field": "Billions",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          2.7
        ],
        "nice": false,
        "zero": true
      },
      "axis": {
        "title": "Production value (A$ billion)",
        "values": [
          0,
          0.5,
          1,
          1.5,
          2,
          2.5
        ],
        "format": ".1f",
        "labelPadding": 8,
        "domain": true,
        "ticks": false,
        "titleFontSize": 14,
        "titleFontWeight": 400,
        "titleColor": "#606060",
        "titlePadding": 16,
        "labelFontSize": 14,
        "domainColor": "#d5d5d5",
        "domainWidth": 1
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "strokeCap": "round",
        "clip": false,
        "point": {
          "filled": true,
          "size": 25,
          "clip": false
        }
      },
      "encoding": {
        "color": {
          "field": "SectorLabel",
          "type": "nominal",
          "scale": {
            "domain": [
              "Aquaculture",
              "State wild catch",
              "Commonwealth wild catch"
            ],
            "range": [
              "#007c91",
              "#a75b20",
              "#203b63"
            ]
          },
          "legend": null
        },
        "order": {
          "field": "StartYear",
          "type": "quantitative"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.SectorLabel == 'Aquaculture'",
            "value": 2.5
          },
          "value": 2
        },
        "strokeDash": {
          "field": "SectorLabel",
          "type": "nominal",
          "scale": {
            "domain": [
              "Aquaculture",
              "State wild catch",
              "Commonwealth wild catch"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                8,
                4
              ],
              [
                2,
                4
              ]
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 140,
        "opacity": 0
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Year",
            "title": "Financial year"
          },
          {
            "field": "SectorLabel",
            "title": "Sector"
          },
          {
            "field": "Billions",
            "type": "quantitative",
            "title": "Production value (A$ billion)",
            "format": ".3f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Sector == 'Commonwealth fisheries' && datum.StartYear == 2024"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#606060",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "Billions",
          "type": "quantitative"
        },
        "y2": {
          "datum": 0.24
        },
        "x2": {
          "datum": 2023.65
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Sector == 'Aquaculture' && datum.StartYear == 2024"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#606060",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "Billions",
          "type": "quantitative"
        },
        "y2": {
          "datum": 2.7
        },
        "x2": {
          "datum": 2023.5
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Sector == 'Aquaculture' && datum.StartYear == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "dx": -16,
        "fontWeight": 600,
        "color": "#292929",
        "fontSize": 12,
        "lineHeight": 16,
        "lineBreak": "|"
      },
      "encoding": {
        "y": {
          "datum": 2.7
        },
        "text": {
          "value": "2024–25|A$0.85 billion above|state wild catch"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Sector == 'Commonwealth fisheries' && datum.StartYear == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "dx": -10,
        "fontWeight": 600,
        "color": "#292929",
        "fontSize": 12,
        "lineHeight": 16,
        "lineBreak": "|"
      },
      "encoding": {
        "y": {
          "datum": 0.24
        },
        "text": {
          "value": "2024–25|2.1% lower than in 1998–99"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.StartYear == 2024"
        },
        {
          "calculate": "datum.SectorLabel == 'Commonwealth wild catch' ? 'Commonwealth|wild catch' : datum.SectorLabel",
          "as": "EndpointLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 0,
        "fontSize": 13,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "EndpointLabel"
        },
        "color": {
          "field": "SectorLabel",
          "type": "nominal",
          "scale": {
            "domain": [
              "Aquaculture",
              "State wild catch",
              "Commonwealth wild catch"
            ],
            "range": [
              "#007c91",
              "#a75b20",
              "#203b63"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Sector == 'Aquaculture' && datum.StartYear == 2016"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#606060",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "Billions",
          "type": "quantitative"
        },
        "y2": {
          "datum": 1.96
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Sector == 'Aquaculture' && datum.StartYear == 2016"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -8,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#292929",
        "lineBreak": "|",
        "lineHeight": 16
      },
      "encoding": {
        "y": {
          "datum": 1.96
        },
        "text": {
          "value": "2016–17|Aquaculture stays ahead|of state wild catch from here"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "background": "transparent"
}
