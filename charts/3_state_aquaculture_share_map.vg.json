{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 405,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13
    },
    "background": "transparent"
  },
  "params": [
    {
      "name": "Year_selection",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 1998,
        "max": 2024,
        "step": 1,
        "name": "Financial year ",
        "element": "#map-year-control"
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "maps/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.2,
        "fill": "#d9ddda"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.State",
            "title": "State or territory"
          },
          {
            "field": "Availability",
            "title": "Data availability"
          }
        ]
      },
      "transform": [
        {
          "calculate": "'No separate production value reported'",
          "as": "Availability"
        }
      ]
    },
    {
      "data": {
        "url": "data/3_state_aquaculture_share_yearly.csv",
        "format": {
          "type": "csv",
          "parse": {
            "YearStart": "number",
            "AquacultureShare": "number",
            "Aquaculture": "number",
            "WildCatch": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.YearStart == Year_selection"
        },
        {
          "lookup": "State",
          "from": {
            "data": {
              "url": "maps/australia_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "states"
              }
            },
            "key": "properties.State"
          },
          "as": "geo"
        },
        {
          "calculate": "format(datum.AquacultureShare, '.1f') + '%'",
          "as": "ShareLabel"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "AquacultureShare",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              25,
              50,
              75,
              100
            ],
            "range": [
              "#edf5f4",
              "#c6e0dd",
              "#78b5b8",
              "#278f9b",
              "#007c91"
            ]
          },
          "legend": {
            "title": "Aquaculture share",
            "orient": "bottom",
            "gradientLength": {
              "expr": "width"
            },
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.label + '%'",
            "offset": 8
          }
        },
        "tooltip": [
          {
            "field": "State",
            "title": "State or territory"
          },
          {
            "field": "ShareLabel",
            "title": "Aquaculture share"
          },
          {
            "field": "Aquaculture",
            "type": "quantitative",
            "title": "Aquaculture (A$ million)",
            "format": ",.1f"
          },
          {
            "field": "WildCatch",
            "type": "quantitative",
            "title": "State wild catch (A$ million)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Longitude": 145,
            "Latitude": -37,
            "EndLongitude": 149,
            "EndLatitude": -38.6
          },
          {
            "Longitude": 146.8,
            "Latitude": -42,
            "EndLongitude": 147,
            "EndLatitude": -43.7
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#777777",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "EndLongitude"
        },
        "latitude2": {
          "field": "EndLatitude"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "State": "Western Australia",
            "Label": "Western|Australia",
            "Longitude": 121,
            "Latitude": -25
          },
          {
            "State": "Northern Territory",
            "Label": "Northern|Territory",
            "Longitude": 133.4,
            "Latitude": -19.4
          },
          {
            "State": "Queensland",
            "Label": "Queensland",
            "Longitude": 144,
            "Latitude": -22.5
          },
          {
            "State": "South Australia",
            "Label": "South|Australia",
            "Longitude": 134.5,
            "Latitude": -29.2
          },
          {
            "State": "New South Wales",
            "Label": "New South|Wales",
            "Longitude": 146.5,
            "Latitude": -32.3
          },
          {
            "State": "Victoria",
            "Label": "Victoria",
            "Longitude": 151.5,
            "Latitude": -39
          },
          {
            "State": "Tasmania",
            "Label": "Tasmania",
            "Longitude": 147,
            "Latitude": -45
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": 600,
        "lineBreak": "|",
        "lineHeight": 13,
        "align": "center",
        "baseline": "middle",
        "color": "#292929"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Label"
        }
      }
    }
  ],
  "padding": 0,
  "background": "transparent"
}
